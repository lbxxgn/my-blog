# Simple Blog - 最简 HTTP(80) 反向代理配置
# ============================================================
# 适用：无域名 / 无证书，直接用公网 IP 通过 80 端口访问。
#
# 用法（替换 /path/to/my-blog 为项目实际路径）：
#   nginx -t -c /path/to/nginx-http.conf.example    # 校验
#   nginx  -c /path/to/nginx-http.conf.example       # 运行
#   或把内容贴进 /etc/nginx/nginx.conf
#
# 注意：HTTP 下 Passkey/WebAuthn 不可用（需 HTTPS 安全上下文）。
# macOS：mime.types 改为 /opt/homebrew/etc/nginx/mime.types
# ============================================================

worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    # 访问日志格式：包含状态码、请求 URI、耗时与上游信息，便于排查 403/502
    log_format app_main '$remote_addr - $remote_user [$time_local] '
                        '"$request" $status $body_bytes_sent '
                        '"$http_referer" "$http_user_agent" '
                        'host="$host" rt=$request_time '
                        'upstream="$upstream_addr" urt=$upstream_response_time';

    access_log /var/log/nginx/access.log app_main;
    error_log  /var/log/nginx/error.log warn;

    # 图片上传对齐 backend/config.py 的 MAX_CONTENT_LENGTH (100MB)
    client_max_body_size 100m;

    upstream simple_blog {
        server 127.0.0.1:5001;
    }

    server {
        listen 80;
        server_name _;                       # 匹配任意主机名 / IP

        access_log /var/log/nginx/my-blog.access.log app_main;
        error_log  /var/log/nginx/my-blog.error.log warn;

        # 静态资源由 nginx 直发（含 /static/frontend/ Vite 产物）
        location /static/ {
            alias /path/to/my-blog/static/;
            expires 30d;
            access_log /var/log/nginx/my-blog.static.access.log app_main;
            # 目录权限不足（常见于项目放在 /root 下）或文件缺失时回退给 Flask
            error_page 403 404 = @static_fallback;
        }

        # 静态文件由 NGINX 无法读取时回退到 Flask，避免移动端直接收到 403
        location @static_fallback {
            proxy_pass http://simple_blog;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_intercept_errors off;
        }

        # 全量备份恢复：允许较大的 ZIP 上传并放宽超时
        location = /admin/backup/restore {
            client_max_body_size 4g;
            proxy_request_buffering off;
            proxy_pass http://simple_blog;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_send_timeout 600s;
            proxy_read_timeout 600s;
        }

        # 其余请求转发到 Flask
        location / {
            proxy_pass http://simple_blog;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;          # AI 接口可能较慢
        }
    }
}
