# =============================================================================
# Simple Blog 环境变量配置模板
# =============================================================================
# 使用方法：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改 .env 文件中的配置值（特别是密码和密钥）
# 3. 运行启动脚本: ./start.sh
# =============================================================================

# -----------------------------------------------------------------------------
# 管理员账号配置（必需）
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin

# ⚠️ 请修改为强密码（至少12位，包含大小写字母和数字）
ADMIN_PASSWORD=YourSecurePassword123!

# -----------------------------------------------------------------------------
# 应用配置
# -----------------------------------------------------------------------------
# ⚠️ 生产环境请使用随机字符串生成密钥
# Python 生成方法: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# 调试模式（开发环境可设为 True，生产环境必须设为 False）
DEBUG=False

# 应用端口（默认 5001）
PORT=5001

# -----------------------------------------------------------------------------
# 网站信息配置
# -----------------------------------------------------------------------------
SITE_NAME=我的博客
SITE_DESCRIPTION=一个简单的博客系统
SITE_AUTHOR=管理员

# -----------------------------------------------------------------------------
# HTTPS 配置（可选）
# -----------------------------------------------------------------------------
# 通过 HTTPS 访问时设为 True（开启 Secure Cookie，Passkey 也需要 HTTPS）
FORCE_HTTPS=False

# -----------------------------------------------------------------------------
# Passkey / WebAuthn 配置（可选）
# -----------------------------------------------------------------------------
# 需要 Passkey 时必须用"域名"（RP ID 不能是 IP），且有受信任的 HTTPS 证书。
# - 海外服务器/未备案拦截的机器：可用 sslip.io 主机名 + Let's Encrypt 证书
#   （公网 IP 1.2.3.4 -> 1-2-3-4.sslip.io，脚本 scripts/setup-https-sslip.sh）
# - 大陆云服务器（阿里云等）用域名会被 ICP 备案拦截（HTTP 403 / Server: Beaver），
#   sslip.io 方案不可用；此时只能用「IP + 自签证书」（scripts/setup-https-selfsigned.sh），
#   而 IP 不能作 RP ID，故 Passkey 不可用，无需配置下面三项。
# PASSKEY_RP_NAME=我的博客
# PASSKEY_RP_ID=1-2-3-4.sslip.io
# PASSKEY_ALLOWED_ORIGINS=https://1-2-3-4.sslip.io

# 受信任设备登录有效期（天）
# REMEMBER_DEVICE_DAYS=90

# Flask 运行环境
FLASK_ENV=production

# -----------------------------------------------------------------------------
# AI功能配置（可选）
# -----------------------------------------------------------------------------
# 说明：API Key 不是环境变量，而是在后台「AI 设置」页按用户配置（存数据库）。
# 下面两个是全局默认值，仅在用户未单独配置时使用。
# 提供商：dashscope（阿里百炼）, deepseek, custom（自定义 OpenAI 兼容）
# AI_DEFAULT_PROVIDER=dashscope
# AI_DEFAULT_MODEL=qwen-turbo

# 限流与内容长度
# AI_RATE_LIMIT_PER_HOUR=10
# AI_CONTENT_MAX_LENGTH=500
# 是否记录 AI 历史（默认启用）
# AI_HISTORY_ENABLED=True
