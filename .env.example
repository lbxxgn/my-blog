# =============================================================================
# Simple Blog 环境变量配置模板
# =============================================================================
# 使用方法：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改 .env 文件中的配置值（特别是密码和密钥）
# 3. 运行启动脚本: ./start.sh
# =============================================================================

# -----------------------------------------------------------------------------
# 管理员账号配置（必需）
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin

# ⚠️ 请修改为强密码（至少12位，包含大小写字母和数字）
ADMIN_PASSWORD=YourSecurePassword123!

# -----------------------------------------------------------------------------
# 应用配置
# -----------------------------------------------------------------------------
# ⚠️ 生产环境请使用随机字符串生成密钥
# Python 生成方法: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# 调试模式（开发环境可设为 True，生产环境必须设为 False）
DEBUG=False

# 应用端口（默认 5001）
PORT=5001

# -----------------------------------------------------------------------------
# 网站信息配置
# -----------------------------------------------------------------------------
SITE_NAME=我的博客
SITE_DESCRIPTION=一个简单的博客系统
SITE_AUTHOR=管理员

# -----------------------------------------------------------------------------
# HTTPS 配置（可选）
# -----------------------------------------------------------------------------
# 通过 HTTPS 访问时设为 True（开启 Secure Cookie，Passkey 也需要 HTTPS）
FORCE_HTTPS=False

# -----------------------------------------------------------------------------
# Passkey / WebAuthn 配置（可选）
# -----------------------------------------------------------------------------
# 无域名方案：把"你的公网IP"写成 sslip.io 主机名即可（横线或点形式均可），
# 例如公网 IP 1.2.3.4 -> 1-2-3-4.sslip.io。无需购买域名、无需备案。
# 证书可用 scripts/setup-https-sslip.sh 一键申请（Let's Encrypt）。
# 注意：Passkey 不能用 IP 直接访问（RP ID 必须是域名）。
# PASSKEY_RP_NAME=我的博客
# PASSKEY_RP_ID=1-2-3-4.sslip.io
# PASSKEY_ALLOWED_ORIGINS=https://1-2-3-4.sslip.io

# 受信任设备登录有效期（天）
# REMEMBER_DEVICE_DAYS=90

# Flask 运行环境
FLASK_ENV=production

# -----------------------------------------------------------------------------
# AI功能配置（可选）
# -----------------------------------------------------------------------------
# AI提供商：dashscope（阿里百炼）, deepseek, custom（自定义OpenAI兼容）
# AI_PROVIDER=dashscope

# 阿里百炼API密钥（如果使用阿里百炼/通义千问）
# 获取方式：https://dashscope.console.aliyun.com/
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API密钥（如果使用DeepSeek）
# 获取方式：https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI模型（可选，留空使用默认模型）
# 阿里百炼默认: qwen-turbo
# DeepSeek默认: deepseek-v4-flash
# AI_MODEL=

# 自定义提供商的 Base URL（仅 AI_PROVIDER=custom 时需要）
# AI_BASE_URL=https://api.example.com/v1

# 启用AI标签生成（默认关闭，设置为1或true启用）
# AI_TAG_GENERATION_ENABLED=0
