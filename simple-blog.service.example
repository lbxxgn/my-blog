[Unit]
Description=Simple Blog Flask Application
Documentation=https://github.com/lbxxgn/my-blog
After=network.target

[Service]
Type=simple

# ============================================
# 用户配置（根据实际情况修改）
# ============================================
# 方式一：使用专用用户（推荐，更安全）
# 需要先创建用户：sudo useradd -r -s /bin/false simpleblog
User=simpleblog
Group=simpleblog

# 方式二：使用 root 用户（简单但不够安全，不推荐）
# User=root
# Group=root

# ============================================
# 路径配置（修改为实际部署路径）
# ============================================
WorkingDirectory=/path/to/my-blog
Environment="PYTHONPATH=/path/to/my-blog"

# ============================================
# 环境变量配置
# ============================================
# 基础配置
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_APP=backend.app"
Environment="FLASK_ENV=production"

# 时区（数据库时间统一存 UTC，展示层按 UTC+8 转换；固定时区避免随服务器漂移）
Environment="TZ=Asia/Shanghai"

# 端口配置（会被 .env 文件中的 PORT 覆盖）
Environment="PORT=5001"

# ============================================
# .env 文件配置（重要！）
# ============================================
# 从 .env 文件加载所有环境变量
# "-" 前缀表示文件不存在时不会报错
EnvironmentFile=-/path/to/my-blog/.env

# ============================================
# 启动命令
# ============================================
# 生产环境使用 gunicorn（勿用 Flask 开发服务器对外服务）
# 默认绑定 127.0.0.1，仅接受本机/Nginx 转发；需直连时再改 0.0.0.0 并放通防火墙
# workers 固定为 1：SQLite 单写 + 限流使用 memory://，多 worker 会导致计数不一致；
# 需要多 worker 并发请先迁移 PostgreSQL 并改用共享限流存储（Redis）。
#
# 日志分离：应用 INFO 走 stdout（-> logs/app.log），ERROR 走 logs/error.log（见 backend/logger.py）。
# gunicorn 自身的日志默认走 stderr，会被 StandardError 收进 error.log；如需单独保存，追加：
#   --access-logfile /path/to/my-blog/logs/access.log \
#   --error-logfile  /path/to/my-blog/logs/gunicorn-error.log
# 全量备份/恢复可能耗时较长，--timeout 需大于 gunicorn 默认的 30s
# 如需每次 restart 前自动重建前端，取消下面一行的注释（构建产物 static/frontend 不入库）：
# ExecStartPre=/path/to/my-blog/scripts/build-frontend.sh
ExecStart=/path/to/my-blog/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:5001 --timeout 300 --graceful-timeout 60 backend.app:app

# ============================================
# 重启策略
# ============================================
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# ============================================
# 日志配置
# ============================================
# 应用自身已写入 logs/app.log 与 logs/error.log；这里改用 journald，避免同一行日志被写入两次。
# 查看：journalctl -u simple-blog -f
StandardOutput=journal
StandardError=journal

# ============================================
# 安全加固（可选）
# ============================================
NoNewPrivileges=true
PrivateTmp=true

# 资源限制（根据需要调整）
# LimitNOFILE=65536
# MemoryLimit=512M

# ============================================
# 安装配置
# ============================================
[Install]
WantedBy=multi-user.target
